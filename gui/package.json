{
  "name": "sjnmusic-gui",
  "version": "0.1.0",
  "description": "Electron-based GUI for sjnmusicd. Pure HTTP client; owns no audio state.",
  "main": "src/main/index.mjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "dev.serverjonas.sjnmusic-gui",
    "productName": "sjnmusic",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "maintainer": "serverjonas"
    }
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  }
}
